{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:a11y": "playwright test e2e/a11y.spec.ts",
		"test:idle": "playwright test e2e/idle.spec.ts",
		"test:perf": "playwright test e2e/perf.spec.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@fontsource/dm-sans": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/lora": "^5.3.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.5.1",
		"@types/three": "^0.186.0",
		"jsdom": "^30.0.1",
		"lighthouse": "^13.5.0",
		"minisearch": "^7.2.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@threlte/core": "^8.6.0",
		"@threlte/extras": "^9.21.1",
		"hls.js": "^1.7.3",
		"three": "^0.186.0",
		"uqr": "^0.1.3"
	}
}
